# Copy to .env for local development. These credentials are local examples only.
SVAAR_ENVIRONMENT=development
SVAAR_DATABASE_URL=postgresql+psycopg://svaar:svaar_dev_only@localhost:5433/svaar
SVAAR_LOG_LEVEL=INFO
SVAAR_DATABASE_TIMEOUT_SECONDS=3
# Compose database initialization; keep these aligned with SVAAR_DATABASE_URL.
POSTGRES_USER=svaar
POSTGRES_PASSWORD=svaar_dev_only
POSTGRES_DB=svaar

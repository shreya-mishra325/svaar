# Copy to .env for local development. These credentials are local examples only.
SVAAR_ENVIRONMENT=development
SVAAR_DATABASE_URL=postgresql+psycopg://svaar:svaar_dev_only@localhost:5433/svaar
SVAAR_LOG_LEVEL=INFO
SVAAR_DATABASE_TIMEOUT_SECONDS=3
# Compose database initialization; keep these aligned with SVAAR_DATABASE_URL.
POSTGRES_USER=svaar
POSTGRES_PASSWORD=svaar_dev_only
POSTGRES_DB=svaar

# Active feature settings. Empty values disable the feature; there are no usable
# defaults. Generate the operator token locally, for example with
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SVAAR_OPERATOR_TOKEN=
# SVAAR_INVITE_TTL_HOURS=72
# SVAAR_CONFIRMATION_TTL_SECONDS=600
# SVAAR_CONFIRMATION_MAX_ATTEMPTS=5
# SVAAR_ALLOW_SAME_CHANNEL_CONFIRMATION=false
# SVAAR_POLICY_HIGH=0.85
# SVAAR_POLICY_LOW=0.55

# Active optional chat/voice model adapter. Set all three together or leave all
# unset. No network request runs at startup; native tool behavior still needs a
# separately authorized live smoke check. Use your provider's confirmed endpoint.
# Team selection (Groq): model openai/gpt-oss-20b, base URL
# https://api.groq.com/openai/v1. Values stay blank to keep fresh copies disabled.
SVAAR_LLM_BASE_URL=
SVAAR_LLM_API_KEY=
SVAAR_LLM_MODEL=

# Active optional gateway settings. Blank selection keeps normal startup disabled.
# Start the gateway explicitly after configuring the selected connection and LLM.
SVAAR_CHANNEL_TRANSPORT=
# SVAAR_GATEWAY_POLL_SECONDS=2
# SVAAR_GATEWAY_BATCH_SIZE=10

# Active standalone Caspian hosted Telegram adapter/probe. Leave blank when unused.
# Set all four to run python -m svaar.agent.caspian_smoke (read-only).
# The probe does not start a listener. Gateway enrollment still requires an invite.
# Existing connections need no bot-token provisioning from Svaar.
SVAAR_CASPIAN_BASE_URL=
SVAAR_CASPIAN_API_KEY=
SVAAR_CASPIAN_TELEGRAM_CONNECTION_ID=
SVAAR_CASPIAN_TELEGRAM_ADDRESS=

# Active optional standalone Bolna REST adapter. No automatic calls.
# Both fields are required when constructing BolnaClient.from_settings.
SVAAR_BOLNA_API_KEY=
SVAAR_BOLNA_AGENT_ID=

# Active status callback only: independent secret, at least 32 characters.
# Blank returns 503. Direct peer must also be a documented Bolna IP.
SVAAR_VOICE_STATUS_SECRET=

# Active optional GitHub inbound webhook secret (32+ characters); app only.
# Blank disables ingress. This is separate from GitHub App credentials.
SVAAR_GITHUB_WEBHOOK_SECRET=

# Planned feature settings from plans/PLAN.md. These are NOT consumed or validated
# by the Settings class yet; add them with their owning feature.
# Leave secrets unset until that feature is implemented. Never commit real values.
# Chat and voice share Svaar's agent; Cerebro is not a runtime dependency.
# SVAAR_CASPIAN_WEBHOOK_SECRET=
# SVAAR_TELEGRAM_BOT_TOKEN=
# SVAAR_JEV_BASE_URL=
# SVAAR_JEV_API_KEY=
# SVAAR_JEV_MODEL=
# SVAAR_VOICE_TURN_MODE=llm_endpoint
# SVAAR_VOICE_TURN_TOKEN=
# SVAAR_GITHUB_APP_ID=
# SVAAR_GITHUB_PRIVATE_KEY_B64=
# SVAAR_GITHUB_INSTALLATION_ID=
# SVAAR_JIRA_BASE_URL=
# SVAAR_JIRA_EMAIL=
# SVAAR_JIRA_API_TOKEN=
# SVAAR_JIRA_DEFAULT_PROJECT_KEY=
